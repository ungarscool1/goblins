# Copy to .env. Everything here is specific to one installation.
COMPOSE_FILE=compose.yaml:compose.real.yaml

# Separate installations, such as home and work, need different values for all of these.
GOBLINS_PROJECT=goblins-personal
GOBLINS_INSTALLATION=personal
GOBLINS_AGENT_VOLUME=goblins-personal-claude-config
GOBLINS_PORT=8080

GOBLINS_VERSION=dev

# From your GitHub App. To use polling only, remove webhook_secret_env from goblins.yaml,
# and set poll_interval on the project.
GOBLINS_WEBHOOK_SECRET=

# Optional: a token from `claude setup-token`, instead of `agent-login`.
CLAUDE_CODE_OAUTH_TOKEN=
