#!/bin/sh
# A fake Claude CLI: same flags and stream format, no network, no tokens.
# FAKE_SCENARIO picks the behavior. Every invocation appends its arguments and the
# billing-related environment to $CLAUDE_CONFIG_DIR/invocations, for assertions.
args="$*"
mkdir -p "$CLAUDE_CONFIG_DIR"
{
  printf 'ARGS %s\n' "$args"
  printf 'ENV ANTHROPIC_API_KEY=[%s] ANTHROPIC_AUTH_TOKEN=[%s]\n' "${ANTHROPIC_API_KEY:-}" "${ANTHROPIC_AUTH_TOKEN:-}"
} >> "$CLAUDE_CONFIG_DIR/invocations"

case "$1" in
  --help)
    if [ "$FAKE_SCENARIO" = "old_cli" ]; then
      echo "Usage: claude --print --output-format --resume --tools"
    else
      echo "Usage: claude --print --restricted --strict-mcp-config --tools --allowedTools --permission-mode --output-format --resume"
    fi
    exit 0 ;;
  auth)
    case "$FAKE_SCENARIO" in
      logged_out) echo '{"loggedIn":false,"authMethod":"none"}'; exit 1 ;;
      api_key) echo '{"loggedIn":true,"authMethod":"apiKey","apiProvider":"firstParty"}'; exit 0 ;;
      bedrock) echo '{"loggedIn":true,"authMethod":"claude.ai","apiProvider":"bedrock"}'; exit 0 ;;
      *) echo '{"loggedIn":true,"authMethod":"claude.ai","apiProvider":"firstParty"}'; exit 0 ;;
    esac ;;
esac

prompt=$(cat)
session="fake-session-1"
prev=""
for a in "$@"; do
  [ "$prev" = "--resume" ] && session="$a"
  prev="$a"
done
printf '{"type":"system","subtype":"init","session_id":"%s","apiKeySource":"%s"}\n' "$session" "${FAKE_KEY_SOURCE:-none}"

case "$FAKE_SCENARIO" in
  rate_limit)
    printf '{"type":"assistant","error":"rate_limit","session_id":"%s","message":{"content":[{"type":"text","text":"You have hit your limit"}]}}\n' "$session"
    printf '{"type":"result","subtype":"success","is_error":true,"result":"Claude usage limit reached","session_id":"%s"}\n' "$session"
    exit 1 ;;
  status_429)
    printf '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"overloaded","api_error_status":429,"session_id":"%s"}\n' "$session"
    exit 1 ;;
  invalid_login)
    printf '{"type":"result","subtype":"success","is_error":true,"result":"Invalid API key. Please run /login","session_id":"%s"}\n' "$session"
    exit 1 ;;
  stderr_login)
    echo "Error: not logged in. Please run /login" >&2
    exit 1 ;;
  gone)
    echo "No conversation found with session ID: $session" >&2
    exit 1 ;;
  crash)
    printf '{"type":"assistant","session_id":"%s","message":{"content":[{"type":"text","text":"working"}]}}\n' "$session"
    echo "segfault" >&2
    exit 139 ;;
  no_result)
    exit 0 ;;
  hang)
    sleep 300 ;;
esac

printf '{"type":"assistant","session_id":"%s","message":{"content":[{"type":"text","text":"thinking"},{"type":"tool_use","name":"Read","input":{"file_path":"x"}}]}}\n' "$session"
printf 'this line is not JSON and must be tolerated\n'
printf '{"type":"result","subtype":"success","is_error":false,"result":"echo: %s","session_id":"%s"}\n' "$prompt" "$session"
